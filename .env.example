# ═══════════════════════════════════════════════════════════════════════
#  CONFIGURAÇÃO DA SUA REDE SOCIAL
# ═══════════════════════════════════════════════════════════════════════
#
#  NÃO edite este arquivo. Ele é só o modelo.
#
#  Rode `pnpm preparar` — ele cria o arquivo `.env` de verdade e sorteia
#  todas as senhas e segredos automaticamente, com segurança.
#
#  O arquivo `.env` nunca vai para o GitHub (está no .gitignore), porque
#  ele contém as chaves que protegem a sua rede.
# ═══════════════════════════════════════════════════════════════════════


# ─── Identidade ────────────────────────────────────────────────────────

# O nome que aparece no app. Pode trocar quando quiser.
NOME_DA_REDE="Nossa Rede"


# ─── Endereço da rede ──────────────────────────────────────────────────

# O endereço pelo qual os celulares vão acessar.
#
#   Em casa (Tailscale):  pc-do-fulano.seu-tailnet.ts.net
#   Numa VPS:             rede.seudominio.com
#
# Para descobrir o seu nome do Tailscale, rode:  tailscale status
DOMINIO=mude-para-o-seu-nome.ts.net

# Como o certificado HTTPS é obtido:
#
#   tailscale    → usa o certificado que o Tailscale emite (para rodar em casa)
#   letsencrypt  → o Caddy pede sozinho um certificado (para a VPS, com domínio real)
#
# HTTPS não é frescura aqui: sem ele, o Android bloqueia câmera e microfone.
MODO_TLS=tailscale

# Só usado quando MODO_TLS=letsencrypt. Serve para a Let's Encrypt te avisar
# se algum certificado estiver perto de vencer.
EMAIL_LETSENCRYPT=


# ─── Banco de dados ────────────────────────────────────────────────────

POSTGRES_USER=rede
POSTGRES_PASSWORD=
POSTGRES_DB=rede_social

# Montado a partir das três linhas acima. O `pnpm preparar` preenche.
DATABASE_URL=


# ─── Segredos do servidor ──────────────────────────────────────────────
#
# Sorteados pelo `pnpm preparar`. Se você trocar qualquer um deles depois:
#
#   JWT_SECRET / COOKIE_SECRET  → todo mundo é deslogado (chato, mas inofensivo)
#   MEDIA_ENCRYPTION_KEY        → as fotos e vídeos do feed VIRAM LIXO, sem volta
#
# Guarde uma cópia do `.env` junto com os seus backups.

JWT_SECRET=
COOKIE_SECRET=
MEDIA_ENCRYPTION_KEY=


# ─── Chamadas de voz e vídeo (TURN) ────────────────────────────────────
#
# O servidor TURN é o "plano B" das chamadas: quando os dois aparelhos não
# conseguem se enxergar direto, ele repassa os pacotes (já criptografados —
# ele não consegue ver nem ouvir nada).

TURN_SECRET=
TURN_REALM=


# ─── Backup ────────────────────────────────────────────────────────────

# Onde os backups ficam guardados nesta máquina.
BACKUP_DIR=./backups

# Quantos dias de backup manter antes de apagar os mais antigos.
BACKUP_RETENCAO_DIAS=14

# Cópia automática para a segunda máquina, pelo Tailscale.
# Deixe em branco para não copiar para lugar nenhum.
#
#   Exemplo:  BACKUP_DESTINO=notebook.seu-tailnet.ts.net
BACKUP_DESTINO=
BACKUP_USUARIO_DESTINO=
BACKUP_CAMINHO_DESTINO=~/backups-rede-social


# ─── Portas ────────────────────────────────────────────────────────────
#
# Só mexa se alguma delas já estiver ocupada por outro programa.
# O `pnpm doutor` avisa se houver conflito.

PORTA_HTTP=80
PORTA_HTTPS=443
PORTA_SERVIDOR=3000
PORTA_POSTGRES=5432


# ─── Limites ───────────────────────────────────────────────────────────

# Tamanho máximo de um arquivo enviado, em megabytes.
TAMANHO_MAXIMO_UPLOAD_MB=100

# Duração máxima de uma mensagem de áudio, em segundos.
DURACAO_MAXIMA_AUDIO_S=300
